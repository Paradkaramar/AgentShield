# AgentShield Platform Configuration
# Tagline: "Who Controls the AI?"

# Application Environment
ENVIRONMENT=development
AGENTSHIELD_PORT=8000
FRONTEND_PORT=5173

# Cryptography & JWT Authentication
AGENTSHIELD_JWT_SECRET=replace-with-your-strong-random-32-byte-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite; PostgreSQL supported)
DATABASE_URL=sqlite:///./agentshield.db
# DATABASE_URL=postgresql://agentshield:agentshield_pass@localhost:5432/agentshield_db

# External LLM Provider Integration (Optional: deterministic fallback enabled by default)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# JARVIS AI Security Assistant Configuration
# Provider options: heuristic (offline neural security engine), gemini, openai, anthropic
JARVIS_LLM_PROVIDER=heuristic
JARVIS_VOICE_SYNTHESIS=true
JARVIS_AUTO_SPEAK=true

# JARVIS Multilingual & Local Privacy Voice Support
# Set to 'true' for strict zero-cloud local speech recognition and voice synthesis
JARVIS_LOCAL_MODE=true
JARVIS_STT_ENGINE=whisper_local
JARVIS_WHISPER_MODEL=small
JARVIS_TTS_ENGINE=piper_indic_local

# Secret Manager / Vault Integration
VAULT_ENCLAVE_SIMULATION=true

