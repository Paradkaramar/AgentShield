# AgentShield Platform Configuration
# Tagline: "Who Controls the AI?"

# Application Environment
ENVIRONMENT=development
AGENTSHIELD_PORT=8000
FRONTEND_PORT=5173

# Cryptography & JWT Authentication
AGENTSHIELD_JWT_SECRET=replace-with-your-strong-random-32-byte-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite; PostgreSQL supported)
DATABASE_URL=sqlite:///./agentshield.db
# DATABASE_URL=postgresql://agentshield:agentshield_pass@localhost:5432/agentshield_db

# Multi-Provider AI Gateway Configuration (Google Gemini, Groq, OpenRouter)
# Replace placeholder values with your genuine keys in your local .env file.
# NEVER commit real keys or push them to Git repositories.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Default AI Provider mode: 'auto' | 'gemini' | 'groq' | 'openrouter' | 'local'
AI_DEFAULT_PROVIDER=auto

# Legacy / Optional Cloud AI Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local AI Runtime Configuration (Ollama / Hugging Face GGUF)
# Suggested candidate: Qwen2.5-3B (Q4_K_M ~1.9 GB, Apache 2.0, low memory footprint)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=45.0
# Set OLLAMA_MODELS to E: drive to preserve Windows C: drive space
OLLAMA_MODELS=E:\ollama_models

# AI Router & JARVIS Assistant Configuration
# Provider options: auto, local, gemini, openai, anthropic, heuristic
JARVIS_LLM_PROVIDER=auto
AI_ROUTER_DEFAULT_PROVIDER=auto
JARVIS_VOICE_SYNTHESIS=true
JARVIS_AUTO_SPEAK=true

# JARVIS Multilingual & Local Privacy Voice Support
# Set to 'true' for strict zero-cloud local speech recognition and voice synthesis
JARVIS_LOCAL_MODE=true
JARVIS_STT_ENGINE=whisper_local
JARVIS_WHISPER_MODEL=small
JARVIS_TTS_ENGINE=piper_indic_local

# Secret Manager / Vault Integration
VAULT_ENCLAVE_SIMULATION=true

